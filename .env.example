# Copy to .env and fill in all values.
# Values come from the CloudFormation stack outputs of the backend deploy
# (scripts/deploy-stack.sh):
#   event-with-me-api   -> ApiBaseUrl (invoke URL, includes /prod)
#   event-with-me-auth  -> UserPoolId, UserPoolClientId

VITE_API_URL=https://<api-id>.execute-api.<region>.amazonaws.com/prod
VITE_COGNITO_USER_POOL_ID=<UserPoolId>
VITE_COGNITO_CLIENT_ID=<UserPoolClientId>
VITE_AWS_REGION=us-east-1
